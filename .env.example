# Seva Sakshi — environment configuration (placeholders only; never commit real secrets)
# Copy to `.env` and fill in. Vite exposes ONLY variables prefixed with VITE_ to the browser,
# so put PUBLIC/client-safe values here. Real server secrets (RTSP creds, DB keys, TURN
# long-term credentials) belong on the server/gateway, NEVER in this file.

# --- Video / WebRTC (real 2-device call) ---------------------------------
# The Live Video Call works out-of-the-box via the PeerJS PUBLIC broker, but
# that shared server is unreliable and can hold "ghost" codes (e.g. INST-001)
# so a real device can't reclaim its id. For reliable 2-device calling, run
# YOUR OWN signaling server:
#
#   npm run signal:share      # starts a PeerServer + opens a public tunnel
#
# It prints the exact VITE_PEERJS_* values below (with a real host). Put them
# in a .env on BOTH laptops and restart each app (npm run dev) — then both use
# your server and INST-001 is always reclaimable (restart the server to clear).
# VITE_PEERJS_HOST=<something>.trycloudflare.com
# VITE_PEERJS_PORT=443
# VITE_PEERJS_PATH=/seva
# VITE_PEERJS_SECURE=true
# VITE_PEERJS_KEY=peerjs
# STUN (NAT discovery) — defaults to Google STUN if unset
# VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN (media relay for restrictive networks) — client ICE config (use short-lived creds in prod)
# VITE_TURN_URL=turn:turn.example.gov.in:3478
# VITE_TURN_USERNAME=turn-user
# VITE_TURN_CREDENTIAL=turn-pass

# --- Permanent phone URL (ngrok free static domain) -----------------------
# Your fixed ngrok static domain for the stable phone URL (npm run tunnel).
# Claim it free at https://dashboard.ngrok.com > Domains. Hostname only — no
# https:// and no path. See README → "A permanent (fixed) phone URL".
# NGROK_DOMAIN=your-name.ngrok-free.dev
# Vite trusts *.ngrok-free.dev / *.ngrok-free.app automatically; set
# VITE_TUNNEL_HOST only for a custom/other tunnel host.
# VITE_TUNNEL_HOST=

# --- Integration modes (honest defaults: not connected) -------------------
# Face / identity recognition provider: not-connected | demo | live
# VITE_RECOGNITION_MODE=not-connected
# CCTV media gateway: not-configured | demo | live
# VITE_CCTV_GATEWAY=not-configured
# Video-check (enterprise random-VC signaling, separate from the P2P Live Call): not-configured | demo | live
# VITE_VIDEO_SERVICE=not-configured

# --- Backend / database (NOT IMPLEMENTED in this repo yet) ----------------
# VITE_API_BASE_URL=https://api.example.gov.in
# Supabase (if adopted): PUBLIC anon key only in the browser; service_role key stays server-side
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- CCTV gateway (SERVER-SIDE ONLY — do NOT put in a browser .env) -------
# RTSP URLs + camera credentials live on the media gateway / backend secret store, never here.
